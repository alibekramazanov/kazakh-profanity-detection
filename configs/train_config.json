{
  "model_name": "FacebookAI/xlm-roberta-base",
  "seed": 42,
  "max_length": 128,
  "truncation": "head_tail",
  "head_tokens": 64,
  "train_batch_size": 32,
  "eval_batch_size": 64,
  "learning_rate": 2e-5,
  "weight_decay": 0.01,
  "num_epochs": 4,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "fp16": true,
  "early_stopping_patience": 2,
  "selection_metric": "val_f1_at_best_threshold",
  "threshold_grid": [0.05, 0.95, 0.01]
}
